# Copy this file to .env and fill in the values

# AI / RAG Notes sidecar
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic        # or: openai
DISTANCE_THRESHOLD=0.7

# App
JWT_SECRET=change-me-in-production

# Avatar storage (S3)
# Note: this AWS account's org SCP only permits general resource creation in eu-north-1
# (us-east-1/us-west-2 are restricted to account-management actions only)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tasksphere-avatars-937370811301
AWS_S3_PUBLIC_URL=            # optional: CDN/custom domain in front of the bucket
